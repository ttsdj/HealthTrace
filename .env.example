# HealthTrace environment template.
# Copy this file to .env and fill local secrets there.
# Never commit .env or real API keys.

# managed: start this repository's Docker Compose services.
# external: reuse services already available at the URLs below.
HEALTHTRACE_INFRA_MODE=managed
HEALTHTRACE_BACKEND_PORT=8000
HEALTHTRACE_FRONTEND_PORT=3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# ===== Database capacity and overload protection =====
# Keep the bulkhead below the total pool capacity to reserve connections for
# background jobs and recovery. Over-limit audited requests receive HTTP 503
# with Retry-After instead of waiting until the pool is exhausted.
HEALTHTRACE_DB_POOL_SIZE=20
HEALTHTRACE_DB_MAX_OVERFLOW=5
HEALTHTRACE_DB_POOL_TIMEOUT_SECONDS=2
HEALTHTRACE_DB_POOL_RECYCLE_SECONDS=1800
HEALTHTRACE_DB_BULKHEAD_LIMIT=12
HEALTHTRACE_DB_BULKHEAD_WAIT_SECONDS=0.05

# ===== LLM: OpenAI-compatible endpoint =====
LLM_API_KEY=replace-with-your-api-key
BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL=replace-with-main-model
FAST_MODEL=replace-with-fast-model
# Intent routing remains deterministic by default. Set fastmodel only after the
# configured small model has passed the frozen intent-router acceptance suite.
INTENT_MODEL=replace-with-intent-model
HEALTHTRACE_INTENT_ROUTER_MODE=rules
HEALTHTRACE_INTENT_ROUTER_TIMEOUT_SECONDS=2
# json_prompt is compatible with providers that do not support response_format.
# Use native only after confirming the endpoint supports JSON schema output.
HEALTHTRACE_INTENT_ROUTER_STRUCTURED_MODE=json_prompt
HEALTHTRACE_TOOL_BULKHEAD_WAIT_SECONDS=0.05
HEALTHTRACE_TOOL_RETRY_BASE_SECONDS=0.05
HEALTHTRACE_TOOL_RETRY_CAP_SECONDS=0.5
HEALTHTRACE_RAG_MAX_PARALLEL_BRANCHES=8
HEALTHTRACE_RAG_BRANCH_QUEUE_TIMEOUT_SECONDS=5
GRADE_MODEL=replace-with-grade-model

# ===== Embedding =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
HF_ENDPOINT=https://hf-mirror.com

# ===== Document parsing =====
# MinerU first; timeout fallback to PyPDF/pypdfium2; OCR only for sparse pages.
MINERU_ENABLED=false
MINERU_MODE=extract
MINERU_COMMAND=mineru-open-api
MINERU_TIMEOUT_SECONDS=10
MINERU_MODEL=pipeline
MINERU_LANGUAGE=ch
MINERU_OCR=true
MINERU_TABLE=true
MINERU_FORMULA=false
MINERU_TOKEN=

# OCR mode: off | fallback | auto | always
DOCUMENT_OCR_MODE=fallback
DOCUMENT_OCR_DEVICE=cpu
DOCUMENT_OCR_ENGINE=transformers
DOCUMENT_OCR_LANG=ch
DOCUMENT_OCR_CACHE_DIR=data/model_cache/paddlex
DOCUMENT_OCR_MODEL_SOURCE=BOS
DOCUMENT_OCR_DPI=220
DOCUMENT_OCR_MIN_TEXT_CHARS=80
DOCUMENT_OCR_MAX_PAGES=8
DOCUMENT_OCR_TABLES=true
DOCUMENT_OCR_FORMULAS=false
DOCUMENT_OCR_CHARTS=false

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_TIMEOUT=30
MILVUS_COLLECTION=med_medical_qa_v2
MILVUS_MEDICAL_QA_COLLECTION=med_medical_qa_v2
MILVUS_PATIENT_RECORD_COLLECTION=healthtrace_patient_record_text_v1
MILVUS_MEDICAL_QA_ARCHIVE_COLLECTION=healthtrace_medical_text_archive_v1
MILVUS_PATIENT_RECORD_ARCHIVE_COLLECTION=healthtrace_patient_record_text_archive_v1
MILVUS_EPISODIC_MEMORY_COLLECTION=med_episodic_memory_v2
MILVUS_SEMANTIC_MEMORY_COLLECTION=med_semantic_memory_v2
MILVUS_INSERT_BATCH_SIZE=100
MILVUS_READ_CONSISTENCY_LEVEL=Strong
MILVUS_FLUSH_AFTER_DELETE=true
HEALTHTRACE_AUTO_MIGRATE=true
HEALTHTRACE_INCREMENTAL_UPDATE_ENABLED=true
HEALTHTRACE_DOCUMENT_UPDATE_LOCK_SECONDS=30
HEALTHTRACE_VERSION_RETENTION_ENABLED=true
HEALTHTRACE_VERSION_RETENTION_DAYS=7
HEALTHTRACE_VERSION_GC_ENABLED=true
HEALTHTRACE_VERSION_GC_INTERVAL_SECONDS=3600
HEALTHTRACE_VERSION_GC_BATCH_SIZE=50
# Optional regexes separated by ;; for volatile metadata lines excluded from embedding identity.
DOCUMENT_EMBEDDING_IGNORE_LINE_PATTERNS=
HEALTHTRACE_PATIENT_DOMAIN_ENABLED=true
HEALTHTRACE_FACT_CANDIDATES_ENABLED=true
PATIENT_FACT_EXTRACTION_MAX_CHARS=16000
PATIENT_FACT_CANDIDATE_LIMIT=50
PATIENT_CONTEXT_MAX_CHARS=3000
HEALTHTRACE_TASK_SCHEDULER_ENABLED=true
HEALTHTRACE_TASK_POLL_SECONDS=30
HEALTHTRACE_JOB_WORKER_ENABLED=true
HEALTHTRACE_JOB_POLL_SECONDS=2
HEALTHTRACE_JOB_CONCURRENCY=2
HEALTHTRACE_JOB_STALE_SECONDS=900
HEALTHTRACE_EXTERNAL_NOTIFICATIONS_ENABLED=false
HEALTHTRACE_NOTIFICATION_TIMEOUT_SECONDS=5
# Webhook URL is server-controlled. HTTPS is required outside localhost.
HEALTHTRACE_NOTIFICATION_WEBHOOK_URL=
HEALTHTRACE_NOTIFICATION_WEBHOOK_SECRET=
HEALTHTRACE_ALLOW_INSECURE_WEBHOOK=false
HEALTHTRACE_SMTP_HOST=
HEALTHTRACE_SMTP_PORT=587
HEALTHTRACE_SMTP_FROM=
HEALTHTRACE_SMTP_USERNAME=
HEALTHTRACE_SMTP_PASSWORD=
HEALTHTRACE_SMTP_STARTTLS=true
HEALTHTRACE_SMTP_SSL=false

# Operational monitoring. OTLP is optional; install with `pip install -e ".[observability]"`.
OTEL_EXPORTER_OTLP_ENDPOINT=
HEALTHTRACE_ALERT_FALLBACK_RATE=0.25
HEALTHTRACE_ALERT_TOOL_SUCCESS_RATE=0.90
HEALTHTRACE_ALERT_TOOL_P95_MS=5000
HEALTHTRACE_GOLDEN_REQUIRED_APPROVALS=2
PROGRESSIVE_INDEX_FIRST_PAGES=20
PROGRESSIVE_INDEX_FIRST_CHUNKS=200

# ===== Retrieval and rerank =====
RETRIEVAL_CANDIDATE_MULTIPLIER=3
# RETRIEVAL_CANDIDATE_K=15
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_API_KEY=
RERANK_MIN_SCORE=0.0

# ===== Database / cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/healthtrace
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=healthtrace

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
# Generate a 32-byte AES key:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
HEALTHTRACE_FIELD_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000
ADMIN_INVITE_CODE=replace-with-local-admin-invite-code

# ===== Optional Neo4j medical knowledge graph =====
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j

# ===== Optional care navigation / map tools =====
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_GEOCODE_TOOL=
AMAP_MCP_AROUND_TOOL=
CARE_NAVIGATION_RADIUS_METERS=10000
CARE_NAVIGATION_RESULT_LIMIT=5
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY=

# Optional hospital website verification.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# ===== RAGCare-QA / RAGAS evaluation =====
RAGCARE_EVAL_COLLECTION=med_ragcare_eval_v1
EVAL_JUDGE_MODEL=replace-with-judge-model
EVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_JUDGE_MODEL=qwen2.5:7b
RAGAS_JUDGE_MODEL=replace-with-ragas-judge-model
RAGAS_EMBEDDING_MODEL=BAAI/bge-m3
RAGAS_EMBEDDING_DEVICE=cpu
RAGAS_EMBEDDING_LOCAL_ONLY=true
RAGAS_CACHE_DIR=data/ragcare/.ragas_cache
RAGAS_TIMEOUT=180
RAGAS_MAX_RETRIES=2
RAGAS_DO_NOT_TRACK=true
